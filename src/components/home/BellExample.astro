---
import { Code } from 'astro:components';
import type { HomeMessages } from '../../locales/home';
import { bellExample as example } from '../../lib/bell-example';

interface Props { messages: HomeMessages['bell']; tutorialHref: string; }
const { messages, tutorialHref } = Astro.props;
const finalStage = example.stages.length - 1;
const basisStates = example.probabilities.map((_, i) => i.toString(2).padStart(example.nQubits, '0'));
const percent = (p: number) => `${Math.round(p * 100)}%`;
const wireY = (q: number) => 22 + q * 48;
---

<figure class="bell-example" data-bell-example data-stages={JSON.stringify(example.stages)}>
  <figcaption class="flex items-baseline justify-between gap-3 mb-3">
    <span class="font-semibold">{messages.title}</span>
    <span class="shrink-0 whitespace-nowrap text-sm text-muted-foreground">{messages.qubits}</span>
  </figcaption>

  <div class="bell-tabs" role="tablist" aria-label={messages.viewsLabel} hidden data-bell-tabs>
    <button type="button" id="bell-tab-result" role="tab" aria-controls="bell-panel-result" aria-selected="true" class="mq-focus-ring" data-bell-tab>{messages.resultLabel}</button>
    <button type="button" id="bell-tab-python" role="tab" aria-controls="bell-panel-python" aria-selected="false" tabindex="-1" class="mq-focus-ring" data-bell-tab>{messages.pythonLabel}</button>
  </div>

  <div class="bell-panels">
    <section id="bell-panel-result" class="bell-panel" data-bell-panel>
      <h2 class="bell-panel-heading">{messages.resultLabel}</h2>
      <div class="bell-circuit">
        <svg viewBox="0 0 400 96" role="img" aria-label={messages.circuitDescription}>
          {Array.from({ length: example.nQubits }, (_, q) => <>
            <text x="0" y={wireY(q) + 5} class="wire-label">q{q} |0⟩</text>
            <line x1="70" x2="390" y1={wireY(q)} y2={wireY(q)} class="wire" />
          </>)}
          {example.gates.map((gate, i) => {
            const x = 150 + i * 130;
            const y = wireY(gate.targets[0]);
            return <g data-bell-gate={i}>
              {gate.controls.map(control => <>
                <line x1={x} x2={x} y1={wireY(control)} y2={y} class="gate-line" />
                <circle cx={x} cy={wireY(control)} r="5" class="control-dot" />
              </>)}
              {gate.controls.length ? <>
                <circle cx={x} cy={y} r="15" class="gate-target" />
                <path d={`M${x - 9} ${y}h18 M${x} ${y - 9}v18`} class="gate-line" />
              </> : <>
                <rect x={x - 19} y={y - 19} width="38" height="38" rx="5" class="gate-box" />
                <text x={x} y={y + 6} text-anchor="middle" class="gate-letter">{gate.name}</text>
              </>}
            </g>;
          })}
        </svg>
      </div>

      <div class="bell-result">
        <div class="flex items-baseline justify-between gap-3 mb-2">
          <span class="text-sm text-muted-foreground">{messages.probabilities}</span>
          <span class="font-mono text-sm text-muted-foreground" aria-hidden="true">q₁q₀</span>
        </div>
        <table class="w-full" aria-label={messages.probabilities}>
          <thead class="sr-only"><tr><th>{messages.outcome}</th><th>{messages.probability}</th></tr></thead>
          <tbody>
            {example.probabilities.map((p, i) => <tr>
              <th scope="row" class="basis-label">|{basisStates[i]}⟩</th>
              <td>
                <div class="probability-row">
                  <span class="probability-track" aria-hidden="true"><span data-bell-bar style={`width: ${percent(p)}`}></span></span>
                  <span data-bell-value class="probability-value">{percent(p)}</span>
                </div>
              </td>
            </tr>)}
          </tbody>
        </table>
        <p class="sr-only" role="status" aria-atomic="true" data-bell-summary>
          {messages.summaries[finalStage]}
        </p>
        <div hidden data-bell-summaries>{messages.summaries.map(text => <span>{text}</span>)}</div>
      </div>

      <div class="bell-controls" role="group" aria-label={messages.stepsLabel} hidden data-bell-controls>
        {messages.steps.map((label, i) => <button type="button" class="mq-btn-ghost mq-btn-compact" data-bell-step={i} aria-pressed={i === finalStage}>
          {label}
        </button>)}
      </div>
      <div class="bell-explanations">
        {messages.explanations.map((text, i) => <p class="bell-explanation" aria-hidden={i !== finalStage} data-bell-explanation>{text}</p>)}
      </div>
    </section>

    <section id="bell-panel-python" class="bell-panel bell-source" data-bell-panel>
      <h2 class="bell-panel-heading">{messages.pythonLabel}</h2>
      <div class="bell-source-heading">
        <span class="font-mono text-xs text-muted-foreground">bell_state.py</span>
        <button type="button" class="mq-btn-ghost mq-btn-compact" hidden data-bell-copy data-copy-text={example.code} data-copied-label={messages.copiedLabel} data-error-label={messages.copyFailedLabel}>{messages.copyLabel}</button>
      </div>
      <Code code={example.code.trimEnd()} lang="python" theme="github-light" wrap />
      <p class="bell-copy-status" role="status" data-bell-copy-status></p>
      <a href={tutorialHref} class="mq-link-arrow text-sm">{messages.tutorialLabel} →</a>
      <p class="bell-method">{messages.method} · MindQuantum {example.version} / mqvector</p>
    </section>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-bell-example]').forEach(figure => {
    const stages: number[][] = JSON.parse(figure.dataset.stages!);
    const buttons = figure.querySelectorAll<HTMLButtonElement>('[data-bell-step]');
    const bars = figure.querySelectorAll<HTMLElement>('[data-bell-bar]');
    const values = figure.querySelectorAll<HTMLElement>('[data-bell-value]');
    const gates = figure.querySelectorAll<SVGGElement>('[data-bell-gate]');
    const explanations = figure.querySelectorAll<HTMLElement>('[data-bell-explanation]');
    const summaries = figure.querySelector('[data-bell-summaries]')!.children;
    const summary = figure.querySelector<HTMLElement>('[data-bell-summary]')!;
    buttons.forEach(button => button.addEventListener('click', () => {
      const stage = Number(button.dataset.bellStep);
      stages[stage].forEach((p, i) => {
        const value = `${Math.round(p * 100)}%`;
        bars[i].style.width = value;
        values[i].textContent = value;
      });
      gates.forEach((gate, i) => gate.classList.toggle('gate-inactive', i >= stage));
      buttons.forEach((item, i) => item.setAttribute('aria-pressed', String(i === stage)));
      explanations.forEach((item, i) => item.setAttribute('aria-hidden', String(i !== stage)));
      summary.textContent = summaries[stage].textContent;
    }));
    figure.querySelector<HTMLElement>('[data-bell-controls]')!.hidden = false;

    const tabs = [...figure.querySelectorAll<HTMLButtonElement>('[data-bell-tab]')];
    const panels = [...figure.querySelectorAll<HTMLElement>('[data-bell-panel]')];
    const selectTab = (selected: number) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === selected));
        tab.tabIndex = i === selected ? 0 : -1;
        panels[i].setAttribute('aria-hidden', String(i !== selected));
        panels[i].inert = i !== selected;
      });
    };
    panels.forEach((panel, i) => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[i].id);
      panel.tabIndex = 0;
    });
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => selectTab(i));
      tab.addEventListener('keydown', event => {
        let next: number;
        switch (event.key) {
          case 'ArrowRight': next = (i + 1) % tabs.length; break;
          case 'ArrowLeft': next = (i - 1 + tabs.length) % tabs.length; break;
          case 'Home': next = 0; break;
          case 'End': next = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        selectTab(next);
        tabs[next].focus();
      });
    });

    const copy = figure.querySelector<HTMLButtonElement>('[data-bell-copy]')!;
    const copyStatus = figure.querySelector<HTMLElement>('[data-bell-copy-status]')!;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copyText!);
        copyStatus.textContent = copy.dataset.copiedLabel!;
      } catch {
        copyStatus.textContent = copy.dataset.errorLabel!;
      }
    });
    copy.hidden = false;
    selectTab(0);
    figure.dataset.enhanced = '';
    figure.querySelector<HTMLElement>('[data-bell-tabs]')!.hidden = false;
  });
</script>

<style>
  .bell-example { margin: 0; padding: 1.5rem; border: 1px solid var(--mq-border); border-radius: var(--mq-radius); background: var(--mq-surface); }
  .bell-tabs { display: flex; gap: 1.5rem; border-bottom: 1px solid var(--mq-border); margin-bottom: 1rem; }
  .bell-tabs[hidden] { display: none; }
  .bell-tabs button { border-bottom: 2px solid transparent; padding: 0 0 0.5rem; font-size: 0.875rem; font-weight: 600; color: var(--mq-text-muted); }
  .bell-tabs [aria-selected="true"] { border-color: var(--mq-primary); color: var(--mq-primary); }
  .bell-panels { display: grid; gap: 1.5rem; }
  .bell-panel { min-width: 0; }
  .bell-panel-heading { margin-bottom: 0.75rem; font-size: 0.875rem; font-weight: 600; }
  /* Both panels size one shared grid track. Inactive content keeps its space,
     but is neither visible nor focusable. No fixed heights or JS measurements. */
  [data-enhanced] .bell-panel { grid-area: 1 / 1; align-self: start; }
  [data-enhanced] .bell-panel-heading { display: none; }
  .bell-panel[aria-hidden="true"] { visibility: hidden; }
  .bell-circuit { margin: 0 0 0.75rem; }
  .bell-circuit svg { display: block; width: 100%; }
  .wire { stroke: var(--mq-border); stroke-width: 2; }
  .wire-label { fill: var(--mq-text-muted); font-family: var(--mq-font-mono); font-size: 15px; }
  .gate-line { stroke: var(--mq-primary); stroke-width: 2; fill: none; }
  .control-dot { fill: var(--mq-primary); }
  .gate-target, .gate-box { fill: var(--mq-surface); stroke: var(--mq-primary); stroke-width: 2; }
  .gate-letter { fill: var(--mq-primary); font-family: var(--mq-font-mono); font-size: 18px; }
  .gate-inactive { opacity: 0.18; }
  .bell-result { border-top: 1px solid var(--mq-border); padding-top: 0.875rem; }
  .basis-label { padding: 0.125rem 1rem 0.125rem 0; width: 3.5rem; text-align: left; font-family: var(--mq-font-mono); font-size: 0.875rem; font-weight: 400; }
  .probability-row { display: flex; align-items: center; gap: 1rem; }
  .probability-track { height: 0.75rem; flex: 1; background: var(--mq-surface-2); }
  .probability-track span { display: block; height: 100%; background: var(--mq-primary); transition: width 220ms ease-out; }
  .probability-value { min-width: 3ch; text-align: right; font-family: var(--mq-font-mono); font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .bell-controls { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 1rem; }
  .bell-controls[hidden] { display: none; }
  .bell-controls button { flex: 1; white-space: nowrap; }
  .bell-controls [aria-pressed="true"] { background: var(--mq-selected); color: var(--mq-selected-text); }
  .bell-explanations { display: grid; margin-top: 0.75rem; }
  .bell-explanation { grid-area: 1 / 1; font-size: 0.875rem; color: var(--mq-text-muted); }
  .bell-explanation[aria-hidden="true"] { visibility: hidden; }
  .bell-source-heading { display: flex; align-items: center; justify-content: space-between; min-height: 2rem; gap: 0.75rem; }
  .bell-source [hidden] { display: none; }
  .bell-source :global(pre) { padding: 0.75rem 0; background: transparent !important; font-size: 0.75rem; line-height: 1.8; }
  .bell-copy-status { min-height: 3em; margin-bottom: 0.75rem; font-size: 0.75rem; line-height: 1.5; color: var(--mq-text-muted); }
  .bell-method { font-size: 0.75rem; color: var(--mq-text-muted); margin-top: 0.75rem; }
  @media (max-width: 639px) {
    .bell-example { padding: 1rem; }
    .bell-controls button { padding-inline: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .probability-track span { transition: none; } }
</style>
