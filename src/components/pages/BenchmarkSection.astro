---
import BenchmarkFigure from "./BenchmarkFigure.astro";
import type { ImageMetadata } from "astro";
import type { BenchmarkSection, BenchmarkMessages } from "../../locales/benchmark";

interface Props {
  section: BenchmarkSection;
  cpuImage: ImageMetadata;
  gpuImage: ImageMetadata;
  id: string;
  reader: BenchmarkMessages["reader"];
  /** Tinted alternative surface for rhythm between consecutive sections. */
  tinted?: boolean;
}

const { section, cpuImage, gpuImage, id, reader, tinted = false } = Astro.props as Props;
---

<section class:list={[tinted ? "bg-muted/30 border-t border-border" : ""]}>
  <div class="mq-container py-20 lg:py-28">
    {/* Section header — asymmetric, left-weighted. */}
    <div class="grid lg:grid-cols-12 gap-x-12 mb-12 lg:mb-14">
      <div class="lg:col-span-9">
        <p class="font-mono mq-caption uppercase tracking-[0.08em] text-muted-foreground">
          {section.kicker}
        </p>
        <h2 class="mt-4 text-display-md font-bold text-foreground tracking-tight">
          {section.heading}
        </h2>
        <p class="mt-5 text-base md:text-lg text-muted-foreground leading-relaxed mq-measure">
          {section.lead}
        </p>
      </div>
    </div>

    <div class="mb-8 grid md:grid-cols-2 gap-x-12 gap-y-3 text-sm text-muted-foreground">
      <p>{reader.axes}</p>
      <p>{reader.precision}</p>
    </div>
    <BenchmarkFigure
      id={`${id}-cpu`} image={cpuImage} label={section.cpuFigLabel}
      alt={section.cpuAlt} caption={section.cpuCaption}
      hardware={reader.cpuHardware} reader={reader}
    />
    <BenchmarkFigure
      id={`${id}-gpu`} image={gpuImage} label={section.gpuFigLabel}
      alt={section.gpuAlt} caption={section.gpuCaption}
      hardware={reader.gpuHardware} reader={reader}
    />

    {/* Finding — large display sentence + mono attribution. No border bar,
        no quote chrome. Typography alone carries the weight. */}
    <div class="mt-14 lg:mt-16 max-w-[44ch] lg:max-w-[58ch]">
      <p class="text-2xl md:text-3xl lg:text-[2rem] font-semibold text-foreground leading-[1.2] tracking-tight">
        {section.finding}
      </p>
      {section.findingHref ? (
        <a
          href={section.findingHref}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-2 font-mono mq-caption uppercase tracking-[0.08em] text-muted-foreground transition-colors hover:text-foreground mq-focus-ring rounded-sm"
        >
          {section.findingSource}
          <svg aria-hidden="true" class="w-3 h-3" viewBox="0 0 24 24">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M7 17L17 7M9 7h8v8"
            />
          </svg>
        </a>
      ) : (
        <p class="mt-5 font-mono mq-caption uppercase tracking-[0.08em] text-muted-foreground">
          {section.findingSource}
        </p>
      )}
    </div>
  </div>
</section>
